ANDROID_KEYSTORE=keystore/jabook-release.jks
ANDROID_KEYSTORE_PASSWORD=changeme
ANDROID_KEY_ALIAS=changeme
ANDROID_KEY_PASSWORD=changeme

# RuTracker mirrors (comma-separated domains) and Retrofit base URL.
# REQUIRED — the build fails without them. These are baked into BuildConfig at
# build time; real connection URLs are never hardcoded in source.
RUTRACKER_DEFAULT_MIRRORS=<mirror1>,<mirror2>
RUTRACKER_BASE_URL=https://<mirror1>/forum/
RUTRACKER_COVER_CDN=https://static.<cdn-host>/
