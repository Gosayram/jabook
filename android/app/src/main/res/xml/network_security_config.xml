<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for JaBook

    Security policy:
    - Base config: cleartext traffic DENIED by default (HTTPS required)
    - System certificate trust anchors for all connections
    - RuTracker mirror domains come from build config (.env) and are HTTPS-only,
      so no per-domain cleartext exceptions are needed.

    For Android 9+ (API 28+), cleartext traffic is disabled by default.
-->
<network-security-config>
    <!-- Base configuration: deny cleartext for all domains by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
